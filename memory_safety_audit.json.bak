  "findings": [
    {
      "id": "MS-001",
      "severity": "critical",
      "category": "delete_vs_free_mismatch",
      "title": "free() called on new-allocated ConfigSubstitutions object",
      "file": "src/libslic3r/Preset.cpp",
      "line": 1547,
      "evidence": "free(preset->loading_substitutions);",
      "context": "loading_substitutions is allocated with 'new ConfigSubstitutions()' at src/libslic3r/Format/bbs_3mf.cpp:2622, but freed with free() instead of delete. This skips the destructor of ConfigSubstitutions (a std::vector<ConfigSubstitution>), corrupting heap metadata and leaking vector contents.",
      "fix": "Replace free(preset->loading_substitutions) with delete preset->loading_substitutions"
    },
    {
      "id": "MS-002",
      "severity": "critical",
      "category": "memory_leak",
      "title": "unique_ptr::release() discards FanMover pointer causing leak",
      "file": "src/libslic3r/GCode.cpp",
      "line": 2411,
      "evidence": "m_fan_mover.release();",
      "context": "m_fan_mover is std::unique_ptr<FanMover> (GCode.hpp:624). Calling .release() without capturing the returned pointer leaks the FanMover object. This runs every time GCode::do_export() is called, so every slice leaks one FanMover.",
      "fix": "Replace m_fan_mover.release() with m_fan_mover.reset()"
    },
    {
      "id": "MS-003",
      "severity": "critical",
      "category": "memory_leak",
      "title": "Vec3f* objects in section_vertices_map never deleted",
      "file": "src/libslic3r/TriangleMeshSlicer.cpp",
      "line": 2361,
      "evidence": "section_vertices_map[facet(i)] = new Vec3f(vertices[i].x(), vertices[i].y(), vertices[i].z());",
      "context": "A std::map<int, Vec3f*> is populated with new Vec3f allocations in a loop. At line 2557, the map is cleared via swap: std::map<int, Vec3f*>().swap(section_vertices_map) — which destroys the map entries but does NOT delete the heap-allocated Vec3f pointers. Every mesh cut operation leaks all these Vec3f objects. Note: OrcaSlicer upstream has fixed this by using std::map<int, Vec3f> (value type, no pointer).",
      "fix": "Change map type from std::map<int, Vec3f*> to std::map<int, Vec3f>, or iterate and delete before swap"
    },
    {
      "id": "MS-004",
      "severity": "high",
      "category": "memory_leak",
      "title": "m_task_manager never freed in OnExit()",
      "file": "src/slic3r/GUI/GUI_App.cpp",
      "line": 3402,
      "evidence": "m_task_manager = new Slic3r::TaskManager(m_agent);",
      "context": "m_task_manager is allocated at line 3402 but OnExit() (lines 2580-2610) deletes m_device_manager and m_user_manager but never deletes m_task_manager. The pointer is declared as raw (GUI_App.hpp:293).",
      "fix": "Add 'delete m_task_manager; m_task_manager = nullptr;' in GUI_App::OnExit() alongside the other manager cleanup"
    },
