# JusPrin Linux Build Docker Image
# Builds JusPrin slicer on Ubuntu 24.04 with all dependencies

FROM ubuntu:24.04

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies matching GitHub Actions environment
RUN apt-get update && apt-get install -y \
    # Build essentials
    build-essential \
    cmake \
    ninja-build \
    git \
    curl \
    wget \
    pkg-config \
    # Core dependencies
    libboost-all-dev \
    libcurl4-openssl-dev \
    libdbus-1-dev \
    libexpat1-dev \
    libglew-dev \
    libgtk-3-dev \
    libgtk-4-dev \
    libgtkmm-3.0-dev \
    libsecret-1-dev \
    libssl-dev \
    libwayland-dev \
    libxkbcommon-dev \
    # Graphics and rendering
    libegl1-mesa-dev \
    libglu1-mesa-dev \
    libgstreamer1.0-dev \
    libgstreamer-plugins-base1.0-dev \
    libnotify-dev \
    librsvg2-dev \
    libspnav-dev \
    libwebkit2gtk-4.0-dev \
    libwebkit2gtk-4.1-dev \
    # Image libraries
    libjpeg-dev \
    libpng-dev \
    libtiff-dev \
    # Additional tools
    autoconf \
    automake \
    gettext \
    gperf \
    libgcrypt20-dev \
    libgirepository1.0-dev \
    libmspack-dev \
    libtool \
    m4 \
    texinfo \
    # Cleanup
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /build

# Copy source code (expects to be run from repo root)
# When building: docker build -f Dockerfile.linux -t jusprin-linux-builder .
COPY . /build/

# Create build script
RUN cat > /build/docker-build.sh << 'EOF'
#!/bin/bash
set -e

echo "=== JusPrin Linux Docker Build ==="
echo "Build started at $(date)"

# Build dependencies first
echo "Building dependencies..."
./build_linux.sh -d

# Build JusPrin slicer
echo "Building JusPrin slicer..."
./build_linux.sh -s

# Optional: Build AppImage
if [ "$BUILD_APPIMAGE" = "1" ]; then
    echo "Building AppImage..."
    ./build_linux.sh -i
fi

echo "Build completed at $(date)"
echo "Artifacts location: /build/build/"
ls -lh /build/build/ || true
EOF

RUN chmod +x /build/docker-build.sh

# Default command: run build
CMD ["/build/docker-build.sh"]

# Build instructions (add to README):
#
# Build the Docker image:
#   docker build -f Dockerfile.linux -t jusprin-linux-builder .
#
# Run the build (dependencies + slicer):
#   docker run --rm -v $(pwd)/build:/build/build jusprin-linux-builder
#
# Run with AppImage:
#   docker run --rm -e BUILD_APPIMAGE=1 -v $(pwd)/build:/build/build jusprin-linux-builder
#
# Interactive debugging:
#   docker run --rm -it jusprin-linux-builder /bin/bash
#
# Extract artifacts:
#   The build output will be in ./build/ directory (mounted volume)
