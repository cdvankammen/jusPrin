# JusPrin Docker Build - Ignore unnecessary files

# Build artifacts
build/
deps/build/
deps/DL_CACHE/
*.o
*.a
*.so
*.dylib
*.dll
*.exe

# Git
.git/
.gitignore
.gitmodules

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Documentation (keep essential, ignore verbose)
*.md
!README.md
!BUILD_WITH_DOCKER.md
!CLAUDE.md

# CI/CD
.github/

# Docker itself
Dockerfile*
docker-compose.yml
.dockerignore

# Logs
*.log

# Temporary files
*.tmp
*.temp
*.cache
